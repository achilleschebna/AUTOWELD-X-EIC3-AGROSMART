              <size>0.05 0.35 0.05</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Grey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <visual name='table_fixed_joint_lump__structure_visual_4'>
          <pose>-0.3 0 0.275 0 -0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.35 0.05</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Grey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <visual name='table_fixed_joint_lump__seams_visual_5'>
          <pose>-0.3 0 0.303 0 -0 0</pose>
          <geometry>
            <box>
              <size>0.012 0.3 0.006</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Red</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
      <static>0</static>
      <!-- ===== AJOUT : commande de trajectoire (gazebo_ros) ===== -->
      <!-- Recoit trajectory_msgs/JointTrajectory sur /robot_a/set_joint_trajectory.
           Un point de la trajectoire est applique a chaque periode (50 Hz). -->
      <plugin name='robot_a_trajectoire' filename='libgazebo_ros_joint_pose_trajectory.so'>
        <ros>
          <namespace>/robot_a</namespace>
        </ros>
        <update_rate>50</update_rate>
      </plugin>
      <!-- Publie les angles des articulations sur /robot_a/joint_states (utile pour RViz) -->
      <plugin name='robot_a_joint_states' filename='libgazebo_ros_joint_state_publisher.so'>
        <ros>
          <namespace>/robot_a</namespace>
        </ros>
        <update_rate>50</update_rate>
        <joint_name>robot_a_joint_1</joint_name>
        <joint_name>robot_a_joint_2</joint_name>
        <joint_name>robot_a_joint_3</joint_name>
        <joint_name>robot_a_joint_4</joint_name>
        <joint_name>robot_a_joint_5</joint_name>
        <joint_name>robot_a_joint_6</joint_name>
      </plugin>
      <pose>0 0 0 0 -0 0</pose>
    </model>
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>1.2 -1.8 1.4 0 0.358 2.297</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
